# Copy to .env.local and fill in. .env.local is gitignored.
#
#   cp .env.example .env.local
#   $EDITOR .env.local
#   source .env.local
#
# up.sh sources .env.local itself if it is present, so sourcing it in your own
# shell is only needed for running guide commands by hand.
#
# Setting a value here and exporting the same variable to a different value in
# your shell is an error rather than a race: up.sh stops and names the variable.

# Solo Enterprise licence. Contact your Solo account team.
export AGENTGATEWAY_LICENSE_KEY=

# The reference LLM provider. Every step from 2 onward needs this.
export ANTHROPIC_API_KEY=

# The OpenAI Moderation guardrail in Step 8.3 only. If this is empty, the
# guardrail block still runs and installs a guardrail with no credential, and
# every request then returns 503. Either set it, or tag that block when=manual.
export OPENAI_API_KEY=
